# Домен сайта (Caddy сам выпустит HTTPS-сертификат; домен должен указывать на IP сервера).
# Без домена: DOMAIN=:80 — обычный HTTP по IP (только для тестов). Для локальной проверки: localhost
DOMAIN=example.com

# Разрешённые Origin для WebSocket (через запятую). Свой домен разрешён всегда.
ALLOWED_ORIGINS=https://example.com

# Уровень ботов: easy | medium | hard
BOT_LEVEL=medium

# Лимит наблюдателей в комнате
MAX_SPECTATORS=20

# Секрет для админ-команд (бан, drain): не короче 24 символов, deploy/install.sh генерирует его сам
# (openssl rand -hex 32). Пустой — админ-команды выключены.
ADMIN_SECRET=

# Имя локальных образов Docker (собираются на сервере из исходников)
VTS_IMAGE=voxel-tactical
