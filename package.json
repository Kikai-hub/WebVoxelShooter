{
  "name": "voxel-tactical-shooter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Браузерный воксельный тактический шутер 5x5: одна комната, режим «Бомба», боты, воксельные раны",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/main.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "esbuild server/src/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server/main.js",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:bots": "tsx tools/botmatch.ts",
    "test:duel": "tsx tools/duel.ts",
    "test:zones": "tsx tools/zones.ts",
    "test:net": "tsx tools/netcheck.ts",
    "test:ranked": "tsx tools/ranked.ts",
    "test:wingman": "tsx tools/wingman.ts",
    "test:party": "tsx tools/party.ts",
    "test:lobby": "tsx tools/lobbye2e.ts",
    "test:assist": "tsx tools/assist.ts",
    "test:sides": "tsx tools/sides.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
