# Домен сайта (Caddy сам выпустит сертификат). Для локальной проверки: localhost
DOMAIN=example.com

# Разрешённые Origin для WebSocket (через запятую). Свой домен разрешён всегда.
ALLOWED_ORIGINS=https://example.com

# Уровень ботов: easy | medium | hard
BOT_LEVEL=medium

# Лимит наблюдателей в комнате
MAX_SPECTATORS=20

# Секрет для админ-команд (бан, drain). Сгенерируйте длинную случайную строку.
ADMIN_SECRET=change-me-to-a-long-random-string

# Образы в GitHub Container Registry (для docker compose pull)
VTS_IMAGE=ghcr.io/your-account/voxel-tactical
